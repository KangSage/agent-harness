{
  "command": "/prompt",
  "alias": "/project-prompt",
  "target": "browser",
  "mode": "task",
  "project": "example-project",
  "role": "task writer",
  "objective": "Use an unsupported target.",
  "current_state": "The fixture is intentionally invalid.",
  "inputs": ["source"],
  "constraints": ["local only"],
  "success_criteria": ["validation fails"],
