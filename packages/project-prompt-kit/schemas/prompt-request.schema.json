{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness:project-prompt-kit:prompt-request:v0.1",
  "title": "Project Prompt Request",
  "type": "object",
  "required": [
    "command",
    "alias",
    "target",
    "mode",
    "project",
    "request",
    "source_of_truth",
    "constraints",
    "desired_output",
    "safety"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "/prompt"
    },
    "alias": {
      "type": "string",
      "const": "/project-prompt"
    },
    "target": {
      "type": "string",
      "enum": ["codex", "claude", "generic"]
    },
    "mode": {
      "type": "string",
      "enum": [
        "choose",
        "task",
        "implement",
        "review",
        "debug",
        "research",
        "docs",
        "release",
        "correction",
        "handoff"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "workspace_strategy": {
      "type": "object",
      "required": [
        "current_checkout",
        "write_scope"
      ],
      "properties": {
        "current_checkout": {
          "type": "string",
          "enum": ["read_only", "writable"]
        },
        "worktree": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_ref": {
              "type": "string",
              "minLength": 1
            },
            "branch_prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "write_scope": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_git_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "infrastructure_boundaries": {
      "type": "object",
      "required": [
        "forbidden_direct_access",
        "human_mediated_actions",
        "allowed_operations",
        "forbidden_operations",
        "data_handling"
      ],
      "properties": {
        "forbidden_direct_access": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "human_mediated_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbidden_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "data_handling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "desired_output": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "required": [
        "telemetry",
        "local_first",
        "no_network",
        "redaction",
        "prompt_injection_boundary",
        "preview_before_share"
      ],
      "properties": {
        "telemetry": {
          "type": "string",
          "const": "off"
        },
        "local_first": {
          "type": "boolean",
          "const": true
        },
        "no_network": {
          "type": "boolean",
          "const": true
        },
        "redaction": {
          "type": "boolean",
          "const": true
        },
        "prompt_injection_boundary": {
          "type": "string",
          "minLength": 1
        },
        "preview_before_share": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
