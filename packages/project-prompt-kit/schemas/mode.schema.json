{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness:project-prompt-kit:mode:v0.1",
  "title": "Project Prompt Mode Metadata",
  "type": "object",
  "required": [
    "name",
    "korean_name",
    "purpose",
    "primary_output",
    "required_prompt_fields",
    "guardrail"
  ],
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "choose",
        "task",
        "plan",
        "implement",
        "review",
        "debug",
        "research",
        "docs",
        "release",
        "correction",
        "handoff"
      ]
    },
    "korean_name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "primary_output": {
      "type": "string",
      "minLength": 1
    },
    "required_prompt_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "guardrail": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
