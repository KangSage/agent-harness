{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness:project-prompt-kit:prompt-contract:v0.2",
  "title": "Project Prompt Contract",
  "type": "object",
  "required": [
    "command",
    "alias",
    "target",
    "mode",
    "project",
    "role",
    "objective",
    "current_state",
    "inputs",
    "constraints",
    "success_criteria",
    "risks",
    "output_format",
    "evidence_required",
    "stop_condition",
    "safety"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "/prompt"
    },
    "alias": {
      "type": "string",
      "const": "/project-prompt"
    },
    "target": {
      "type": "string",
      "enum": ["codex", "claude", "generic"]
    },
    "mode": {
      "type": "string",
      "enum": [
        "choose",
        "task",
        "plan",
        "implement",
        "review",
        "debug",
        "research",
        "docs",
        "release",
        "correction",
        "handoff"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "workspace_strategy": {
      "type": "object",
      "required": [
        "current_checkout",
        "write_scope"
      ],
      "properties": {
        "current_checkout": {
          "type": "string",
          "enum": ["read_only", "writable"]
        },
        "worktree": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_ref": {
              "type": "string",
              "minLength": 1
            },
            "branch_prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "write_scope": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_git_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "infrastructure_boundaries": {
      "type": "object",
      "required": [
        "forbidden_direct_access",
        "human_mediated_actions",
        "allowed_operations",
        "forbidden_operations",
        "data_handling"
      ],
      "properties": {
        "forbidden_direct_access": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "human_mediated_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbidden_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "data_handling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "communication_policy": {
      "type": "object",
      "required": [
        "user_facing_language",
        "agent_facing_language",
        "agent_facing_style",
        "preserve_verbatim"
      ],
      "properties": {
        "user_facing_language": {
          "type": "string",
          "minLength": 1
        },
        "agent_facing_language": {
          "type": "string",
          "minLength": 1
        },
        "agent_facing_style": {
          "type": "string",
          "minLength": 1
        },
        "preserve_verbatim": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "review_panel": {
      "type": "object",
      "required": [
        "selection_policy",
        "reviewers"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "implementation_review",
            "production_incident",
            "policy_or_customer_notice",
            "new_feature_planning",
            "docs_or_handoff"
          ]
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "perspective",
              "output"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "perspective": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "high_risk"
          ]
        },
        "scenario_template": {
          "type": "string",
          "enum": [
            "auth_migration",
            "production_incident",
            "regulated_data_or_domain"
          ]
        }
      },
      "additionalProperties": false
    },
    "decision_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "owner",
          "required_evidence",
          "pass_condition",
          "status",
          "evidence",
          "rationale",
          "blocking_reason",
          "human_decision_required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "string",
            "minLength": 1
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "blocked",
              "needs_human_decision",
              "accepted_risk",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "blocking_reason": {
            "type": "string",
            "minLength": 1
          },
          "human_decision_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "output_format": {
      "type": "string",
      "minLength": 1
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "required": [
        "telemetry",
        "local_first",
        "no_network",
        "redaction",
        "prompt_injection_boundary",
        "preview_before_share"
      ],
      "properties": {
        "telemetry": {
          "type": "string",
          "const": "off"
        },
        "local_first": {
          "type": "boolean",
          "const": true
        },
        "no_network": {
          "type": "boolean",
          "const": true
        },
        "redaction": {
          "type": "boolean",
          "const": true
        },
        "prompt_injection_boundary": {
          "type": "string",
          "minLength": 1
        },
        "preview_before_share": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
